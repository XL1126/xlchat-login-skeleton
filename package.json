{
  "name": "xl-chat",
  "version": "1.0.0",
  "description": "XL Chat",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "dev:https": "concurrently \"npm run server:dev\" \"npm run client:dev:https\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "client:dev:https": "cd client && npm run dev:https",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
